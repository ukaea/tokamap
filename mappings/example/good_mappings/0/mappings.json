{
  "string_value_mapping": "value",
  "integer_value_mapping": 42,
  "float_value_mapping": 3.14,
  "array_value_mapping": {
    "map_type": "VALUE",
    "value": [1, 2, 3, 4, 5]
  },
  "data_source_mapping": {
    "map_type": "DATA_SOURCE",
    "data_source": "MyDataSource",
    "args": {
      "signal": "coils"
    }
  },
  "dimension_mapping": {
    "map_type": "DIMENSION",
    "dim_probe": "data_source_mapping"
  },
  "expression_mapping": {
    "map_type": "EXPR",
    "expr": "pi * r^2",
    "parameters": {
      "r": "float_value_mapping"
    }
  },
  "custom_function_mapping": {
    "map_type": "CUSTOM",
    "library": "custom",
    "function": "dot_product",
    "inputs": {
      "lhs": "data_source_mapping",
      "rhs": "data_source_mapping"
    },
    "parameters": {}
  },
  "_interp_input": {
    "map_type": "VALUE",
    "value": [10, 20, 40, 80]
  },
  "_interp_base": {
    "map_type": "VALUE",
    "value": [0, 1, 2, 3]
  },
  "_interp_target": {
    "map_type": "VALUE",
    "value": [0.5, 1.5, 2.5]
  },
  "interp_mapping": {
    "map_type": "INTERP",
    "input": "_interp_input",
    "base": "_interp_base",
    "target": "_interp_target",
    "type": "LINEAR",
    "args": {},
    "comment": "Should yield [15,30,60]"
  }
}
