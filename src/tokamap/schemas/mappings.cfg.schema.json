{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "JSON Schema for TokaMap configuration files",
  "type": "object",
  "required": ["metadata", "partitions", "groups"],
  "properties": {
    "$schema": {
      "description": "Format version this file follows: any base URL or path ending in /<version>/mappings.cfg.schema.json",
      "type": "string",
      "pattern": "/v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?/mappings\\.cfg\\.schema\\.json$"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "partitions": {
      "$ref": "#/$defs/partitions"
    },
    "groups": {
      "$ref": "#/$defs/groups"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "experiment": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attribute": { "type": "string" },
          "selector": { "enum": ["MAX_BELOW", "MIN_ABOVE", "EXACT", "CLOSEST"] }
        },
        "additionalProperties": false,
        "required": ["attribute", "selector"]
      }
    }
  }
}
